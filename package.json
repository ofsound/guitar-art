{
  "name": "guitar-art",
  "version": "0.1.0",
  "description": "Native guitar-driven art synthesizer MVP.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "dev": "npm run build:native:debug && electron-forge start",
    "package": "npm run build:native && electron-forge package",
    "make": "npm run build:native && electron-forge make",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:native && electron-forge package",
    "build:native": "npm --prefix native/audio-engine run build",
    "build:native:debug": "npm --prefix native/audio-engine run build:debug",
    "test:renderer": "node scripts/renderer-smoke.mjs",
    "test:native": "cargo test --manifest-path native/audio-engine/Cargo.toml",
    "test": "npm run typecheck && npm run test:native && npm run test:renderer"
  },
  "dependencies": {
    "@electron-forge/plugin-vite": "^7.8.3",
    "@napi-rs/cli": "^3.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.2.1",
    "playwright": "^1.52.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
